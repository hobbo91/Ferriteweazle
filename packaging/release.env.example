# Copy to packaging/release.env (ignored by git) and name your build machines.
# Linux: any machine with Rust, cargo-zigbuild, zig and what BUILDING.md lists
# for Linux, and a way to run the other processor's Python (Rosetta or qemu
# with its libraries).
LINUX_SSH="user@linux-host"
LINUX_DIR="ferriteweazle"
LINUX_SETUP="export PATH=\$HOME/.cargo/bin:\$HOME/zig:\$HOME/.local/bin:\$PATH LD_LIBRARY_PATH=/usr/x86_64-linux-gnu/lib"
# The fingerprint of the key in its GnuPG keyring that signs the AppImages;
# empty, they are not signed.
LINUX_SIGN_KEY=""
# Windows: OpenSSH, Git for Windows, Rust with both MSVC targets, Visual
# Studio's build tools and WiX 5; its folder must exist.
WINDOWS_SSH="-i ~/.ssh/key user@windows-host"
WINDOWS_DIR="C:/Users/user/ferriteweazle"
